# Local development only. Copy this file to .env; never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Compose and DATABASE_URL must refer to the same credentials/port/database.
POSTGRES_USER=support
POSTGRES_PASSWORD=support-local-only
POSTGRES_DB=support
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://support:support-local-only@localhost:55432/support
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Reserved observability configuration; no trace export is implemented in this feature.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# No model, payment, shipping or ticketing provider keys are needed yet.
